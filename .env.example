# Supabase — create a project at https://supabase.com/dashboard
# Project Settings → API → Project URL + anon / publishable key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Google sign-in (required for the Google button to work):
# 1. Authentication → Providers → Google → Enable
# 2. Create OAuth client in Google Cloud Console (Web application)
#    Authorized redirect URI must be exactly:
#      https://YOUR_PROJECT.supabase.co/auth/v1/callback
# 3. Paste Client ID + Client Secret into Supabase Google provider
# 4. Authentication → URL Configuration:
#      Site URL: https://matcha-pocket.vercel.app
#      Redirect URLs:
#        http://localhost:5173/**
#        https://matcha-pocket.vercel.app/**
#
# Apple: no sign-in button at the moment — it needs a paid Apple Developer
# membership (Services ID + key). To bring it back, enable Authentication →
# Providers → Apple in Supabase and render signInWithApple from src/auth.tsx.
#
# Cloud sync (spots + collection across devices):
# Run supabase/user_library.sql once in the Supabase SQL Editor
