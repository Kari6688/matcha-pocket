# Supabase — create a project at https://supabase.com/dashboard
# Project Settings → API → Project URL + anon public key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Then enable Google:
# Authentication → Providers → Google → enable
# Paste Client ID + Client Secret from Google Cloud Console
# Authentication → URL Configuration:
#   Site URL: https://matcha-app-nu.vercel.app
#   Redirect URLs: http://localhost:5173/** and https://matcha-app-nu.vercel.app/**
